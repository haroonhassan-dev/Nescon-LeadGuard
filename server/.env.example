# ====================================================
# Nescon-LeadGuard Backend Environment Configuration
# Copy to server/.env and fill in. Never commit server/.env.
# ====================================================

# Runtime Environment
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Base URL of the frontend, used in alert and invite links
APP_BASE_URL=http://localhost:5173

# Database (PostgreSQL). For Neon use the DIRECT (non-pooled) connection string:
# postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Sessions (opaque bearer tokens stored hashed in the database)
SESSION_TTL_HOURS=72

# Escalation worker
WORKER_INTERVAL_MS=2000
# Set to true to run an API process without the worker
DISABLE_WORKER=false

# Demo seed (npm run db:seed). Leave empty to generate a random password at seed time.
SEED_DEMO_PASSWORD=

# Integrations: Twilio (WhatsApp sandbox / SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Integrations: Stripe (TEST MODE keys only: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Integrations: Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google-calendar/oauth2callback

# Integrations: Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Integrations: Vonage Messages API (WhatsApp sandbox) — replaces Twilio for messaging
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Dashboard → Settings → Signature secret (verifies Vonage's signed webhooks)
VONAGE_SIGNATURE_SECRET=
# Sandbox WhatsApp number, digits only (e.g. 14157386102)
VONAGE_WHATSAPP_NUMBER=
# Leave empty for the sandbox; https://api.nexmo.com for production
VONAGE_API_URL=
