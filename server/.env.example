# ====================================================
# Nescon-LeadGuard Backend Environment Configuration
# ====================================================

# Runtime Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nescon_leadguard?schema=public

# Authentication Secrets
JWT_SECRET=leadguard_dev_secret_replace_in_production_32chars_min
JWT_EXPIRES_IN=7d

# Integrations: Twilio (SMS & Voice)
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=mock_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+15550001122

# Integrations: Stripe (STRICTLY TEST MODE)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_placeholder
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_placeholder

# Integrations: Google Calendar OAuth
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google-calendar/oauth2callback

# Integrations: Telegram Bot
TELEGRAM_BOT_TOKEN=0000000000:MOCK_telegram_bot_token_placeholder
TELEGRAM_WEBHOOK_SECRET=mock_telegram_webhook_secret_key
