// Nescon-LeadGuard Prisma Schema
// Multi-tenant: every business row carries workspaceId, and every query filters by it.
// Use the DIRECT (non-pooled) connection string for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------
enum BaseLevel {
  OWNER
  ADMIN
  USER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
  OFFLINE
}

enum LeadSource {
  WEB_FORM
  WHATSAPP
  SMS
  MANUAL
}

enum LeadStatus {
  UNASSIGNED
  ASSIGNED
  ACKNOWLEDGED
  CLOSED
}

enum AssignmentKind {
  INITIAL
  ESCALATION
  MANUAL
  OWNER_UNAVAILABLE
  CLAIM
  RECOVERY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  NO_CHANNEL
}

// ----------------------------------------------------
// WORKSPACE & TENANCY
// ----------------------------------------------------
model Workspace {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  publicFormKey String   @unique // identifies the workspace on the public web form
  timezone      String   @default("UTC")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships            Membership[]
  roles                  Role[]
  invitations            Invitation[]
  assignmentSettings     AssignmentSettings?
  contacts               Contact[]
  companies              Company[]
  pipelines              Pipeline[]
  opportunities          Opportunity[]
  leads                  Lead[]
  leadAssignments        LeadAssignment[]
  leadActivities         LeadActivity[]
  notifications          Notification[]
  auditEvents            AuditEvent[]
  payments               Payment[]
  messages               Message[]
  appointments           Appointment[]
  integrationConnections IntegrationConnection[]
  integrationEvents      IntegrationEvent[]

  @@map("workspaces")
}

// ----------------------------------------------------
// IDENTITY, SESSIONS, MEMBERSHIP, ROLES
// ----------------------------------------------------

// A person. One login, can belong to several workspaces through Membership.
model User {
  id               String    @id @default(uuid())
  email            String    @unique // stored lowercased
  passwordHash     String // scrypt, salted; never returned by the API
  firstName        String
  lastName         String
  phone            String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships     Membership[]
  sessions        Session[]
  ownedLeads      Lead[]           @relation("LeadCurrentOwner")
  leadAssignments LeadAssignment[]
  appointments    Appointment[]    @relation("UserAppointments")
  opportunities   Opportunity[]    @relation("UserOpportunities")

  @@map("users")
}

// Opaque bearer session. Only the SHA-256 of the token is stored, so a DB leak exposes no live tokens.
model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Configurable permission set. "Manager" is just a Role with extra permissions.
model Role {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([workspaceId, name])
  @@map("roles")
}

// A user's place in one workspace: base level, role, availability and capacity.
model Membership {
  id                    String             @id @default(uuid())
  workspaceId           String
  userId                String
  baseLevel             BaseLevel
  roleId                String? // null only for OWNER, who implicitly holds every permission
  status                MembershipStatus   @default(ACTIVE)
  availability          AvailabilityStatus @default(OFFLINE)
  availabilityChangedAt DateTime           @default(now())
  autoAssignEnabled     Boolean            @default(true)
  maxOpenLeads          Int? // null = workspace default
  lastAssignedAt        DateTime? // round-robin cursor
  telegramChatId        String? // per-user alert routing (I4.3)
  notificationEmail     String?
  version               Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([workspaceId, availability])
  @@map("memberships")
}

model Invitation {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  baseLevel   BaseLevel
  roleId      String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("invitations")
}

// ----------------------------------------------------
// LEAD ENGINE
// ----------------------------------------------------

// One row per workspace. All timers are in SECONDS so a demo can show escalation live.
model AssignmentSettings {
  workspaceId                 String   @id
  ackTimeoutSeconds           Int      @default(60)
  maxOpenLeadsPerUser         Int      @default(10)
  // Ordered chain after the first assignment: [{ "target": "NEXT_ELIGIBLE" | "BACKUP" | "MANAGER", "timeoutSeconds": 60 }]
  escalationLevels            Json
  backupUserId                String?
  managerUserId               String?
  idleThresholdSeconds        Int      @default(900)
  recoveryEscalationThreshold Int      @default(2)
  // What happens to ACKNOWLEDGED leads when their owner goes On leave / Offline (F3.6)
  acknowledgedLeadPolicy      String   @default("KEEP_WITH_OWNER") // KEEP_WITH_OWNER | REASSIGN
  version                     Int      @default(0)
  updatedAt                   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("assignment_settings")
}

model Lead {
  id           String     @id @default(uuid())
  workspaceId  String
  title        String
  contactName  String
  contactEmail String?
  contactPhone String?
  message      String?
  source       LeadSource
  status       LeadStatus @default(UNASSIGNED)
  contactId    String?
  createdById  String?

  // Single owner. Changed only through conditional updates on `version`.
  currentOwnerId      String?
  assignmentSeq       Int       @default(0) // matches the latest LeadAssignment.seq
  escalationLevel     Int       @default(0) // 0 = first assignment; n = n-th step of the chain
  escalationCount     Int       @default(0) // automatic escalations only
  manualReassignCount Int       @default(0)
  escalationExhausted Boolean   @default(false)
  firstAssignedAt     DateTime?
  lastAssignedAt      DateTime?
  ackDeadline         DateTime?
  acknowledgedAt      DateTime?
  firstAcknowledgedAt DateTime?
  lastActivityAt      DateTime  @default(now())
  closedAt            DateTime?

  intakeKey String? // external idempotency key (e.g. provider message id)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentOwner  User?            @relation("LeadCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: SetNull)
  contact       Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignments   LeadAssignment[]
  activities    LeadActivity[]
  notifications Notification[]
  opportunities Opportunity[]
  messages      Message[]
  appointments  Appointment[]
  payments      Payment[]

  @@unique([workspaceId, intakeKey])
  @@index([status, ackDeadline])
  @@index([workspaceId, status])
  @@index([workspaceId, currentOwnerId])
  @@index([workspaceId, createdAt])
  @@map("leads")
}

// Ownership history. UNIQUE(leadId, seq) is what makes "escalate exactly once" hold:
// two workers escalating the same assignment both try to insert seq+1, and one fails.
model LeadAssignment {
  id             String         @id @default(uuid())
  workspaceId    String
  leadId         String
  seq            Int
  userId         String?
  kind           AssignmentKind
  level          Int
  reason         String
  assignedAt     DateTime       @default(now())
  deadline       DateTime?
  acknowledgedAt DateTime? // set when this owner acknowledged; drives personal response time
  endedAt        DateTime?
  endReason      String? // ACKNOWLEDGED | ACK_TIMEOUT | REASSIGNED | OWNER_UNAVAILABLE | CLOSED

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([leadId, seq])
  @@index([workspaceId, kind, assignedAt])
  @@index([workspaceId, userId])
  @@map("lead_assignments")
}

// Time-ordered history shown on the lead (F2.7).
model LeadActivity {
  id          String   @id @default(uuid())
  workspaceId String
  leadId      String
  actorType   String // USER | SYSTEM | INTEGRATION
  actorId     String?
  kind        String // CREATED | ASSIGNED | ACKNOWLEDGED | ESCALATED | REASSIGNED | NOTE | MESSAGE | CALL | STAGE_CHANGE | APPOINTMENT | CLOSED | UNASSIGNED
  body        String?
  data        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// Outbox: written in the same transaction as the escalation, sent afterwards by the worker.
model Notification {
  id              String             @id @default(uuid())
  workspaceId     String
  leadId          String?
  recipientUserId String
  kind            String // ESCALATION
  channel         String?
  payload         Json
  status          NotificationStatus @default(PENDING)
  attempts        Int                @default(0)
  maxAttempts     Int                @default(3)
  nextAttemptAt   DateTime           @default(now())
  lastError       String?
  externalId      String?
  sentAt          DateTime?
  dedupeKey       String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([workspaceId, status])
  @@map("notifications")
}

// ----------------------------------------------------
// AUDIT (append-only; UPDATE/DELETE blocked by a DB trigger in the migration)
// ----------------------------------------------------
model AuditEvent {
  id            String   @id @default(uuid())
  workspaceId   String
  actorType     String // USER | SYSTEM | INTEGRATION
  actorId       String?
  actorName     String?
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  ipAddress     String?
  requestId     String?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@index([workspaceId, actorId])
  @@index([workspaceId, entityType, entityId])
  @@map("audit_events")
}

// ----------------------------------------------------
// CRM
// ----------------------------------------------------
model Contact {
  id          String   @id @default(uuid())
  workspaceId String
  companyId   String?
  firstName   String
  lastName    String   @default("")
  email       String?
  phone       String? // E.164
  optedOut    Boolean  @default(false) // I1.9
  tags        String[] @default([])
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads         Lead[]
  opportunities Opportunity[]
  messages      Message[]
  appointments  Appointment[]
  payments      Payment[]

  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@map("contacts")
}

model Company {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  domain      String?
  phone       String?
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  opportunities Opportunity[]

  @@index([workspaceId, name])
  @@map("companies")
}

model Pipeline {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([workspaceId])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  workspaceId String
  pipelineId  String
  name        String
  position    Int
  isWonStage  Boolean  @default(false)
  isLostStage Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model Opportunity {
  id             String   @id @default(uuid())
  workspaceId    String
  title          String
  value          Decimal  @default(0.00) @db.Decimal(12, 2)
  currency       String   @default("USD")
  pipelineId     String
  stageId        String
  contactId      String?
  companyId      String?
  leadId         String?
  assignedUserId String?
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser User?         @relation("UserOpportunities", fields: [assignedUserId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([workspaceId, stageId])
  @@map("opportunities")
}

// ----------------------------------------------------
// INTEGRATION-OWNED DATA (models owned here; adapters live in server/src/integrations)
// ----------------------------------------------------
model Payment {
  id                    String    @id @default(uuid())
  workspaceId           String
  leadId                String?
  opportunityId         String?
  contactId             String?
  requestedById         String?
  amount                Int // cents
  currency              String    @default("usd")
  status                String // PENDING | PAID | EXPIRED | FAILED | REFUNDED | PARTIALLY_REFUNDED
  provider              String    @default("stripe")
  providerReference     String    @unique // Stripe Checkout Session id (cs_test_...)
  stripePaymentIntentId String?   @unique // pi_... ; refunds arrive keyed by this
  checkoutUrl           String?
  refundedAmount        Int       @default(0)
  failureReason         String?
  expiresAt             DateTime?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@map("payments")
}

model Message {
  id                String    @id @default(uuid())
  workspaceId       String
  leadId            String?
  contactId         String?
  channel           String // WHATSAPP | SMS
  direction         String // INBOUND | OUTBOUND
  sender            String
  recipient         String
  body              String    @db.Text
  status            String    @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | RECEIVED
  externalMessageId String?
  errorMessage      String?
  sentById          String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, externalMessageId])
  @@index([workspaceId, contactId, createdAt])
  @@map("messages")
}

model Appointment {
  id                    String   @id @default(uuid())
  workspaceId           String
  leadId                String?
  contactId             String?
  assignedUserId        String
  title                 String
  startTime             DateTime // UTC
  endTime               DateTime // UTC
  timezone              String   @default("UTC")
  status                String   @default("CONFIRMED") // CONFIRMED | RESCHEDULED | CANCELLED
  googleCalendarEventId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser User      @relation("UserAppointments", fields: [assignedUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startTime])
  @@index([assignedUserId, startTime])
  @@map("appointments")
}

// Per-workspace provider connection. Secrets are stored encrypted, never returned in full.
model IntegrationConnection {
  id              String    @id @default(uuid())
  workspaceId     String
  provider        String // twilio | stripe | google_calendar | telegram
  userId          String? // set for per-user connections (Google Calendar)
  status          String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | ERROR
  encryptedConfig String? // ciphertext of credentials / tokens
  publicConfig    Json? // non-secret settings (e.g. sandbox number, masked key)
  lastSuccessAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, userId])
  @@map("integration_connections")
}

// Synchronization history + webhook deduplication (I5.4, I1.8, I2.4).
model IntegrationEvent {
  id          String   @id @default(uuid())
  workspaceId String?
  provider    String
  direction   String // INBOUND | OUTBOUND
  eventType   String
  externalId  String? // provider event id; unique per provider for dedup
  result      String // OK | REJECTED | FAILED | DUPLICATE
  detail      String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([workspaceId, provider, createdAt])
  @@map("integration_events")
}
